# Salesforce login domain: use https://login.salesforce.com for a Developer Edition org,
# or https://test.salesforce.com for a sandbox.
SF_LOGIN_URL=https://login.salesforce.com

# From your External Client App (Setup -> External Client Apps -> App Settings -> OAuth Settings)
SF_CLIENT_ID=PASTE_CONSUMER_KEY_HERE
SF_CLIENT_SECRET=PASTE_CONSUMER_SECRET_HERE

# Must exactly match one of the "Callback URLs" configured on the External Client App
SF_REDIRECT_URI=http://localhost:3000/auth/callback

SF_API_VERSION=v60.0

# Any long random string
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000
